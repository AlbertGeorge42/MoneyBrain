generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // 必须由调用方显式设置 DATABASE_URL；不设时 Prisma 直接报错，不再静默连接 dev.db。
  url      = env("DATABASE_URL")
}

model AccountCategory {
  id               String             @id @default(uuid())
  name             String
  type             String
  parentId         String?
  sort             Int                @default(0)
  parent           AccountCategory?   @relation("AccountCategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children         AccountCategory[]  @relation("AccountCategoryTree")
  isCashEquivalent Boolean            @default(false)
  isInvestment     Boolean            @default(false)
  iconKey          String? // 受控图标 key（CATEGORY_ICON_KEYS）；null = 前端默认图标
  accounts         Account[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  rev              Int                @default(1) // 本设备本地修订号，每次写入 +1（F-A）
  vv               String? // 版本向量 JSON {deviceId: maxRev}（F-A）

  @@index([parentId])
  @@map("account_categories")
}

model Account {
  id                  String            @id @default(uuid())
  name                String
  type                String
  initialBalance      BigInt            @default(0)
  initialBalanceDate  DateTime?
  categoryId          String?
  sort                Int               @default(0)
  category            AccountCategory?  @relation(fields: [categoryId], references: [id])
  fromTransactions    Transaction[]     @relation("TransactionFrom")
  toTransactions      Transaction[]     @relation("TransactionTo")
  fromBudgets         Budget[]          @relation("BudgetFrom")
  toBudgets           Budget[]          @relation("BudgetTo")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  rev                 Int               @default(1) // 本设备本地修订号，每次写入 +1（F-A）
  vv                  String? // 版本向量 JSON {deviceId: maxRev}（F-A）

  investmentAssetClasses     InvestmentAssetClass[]
  investmentAllocationSnapshots InvestmentAllocationSnapshot[]

  @@index([categoryId])
  @@index([type])
  @@map("accounts")
}

model TransactionCategory {
  id           String              @id @default(uuid())
  name         String
  type         String              // 'income' | 'expense' | 'transfer'
  cashFlowType String?
  iconKey      String?             // 受控图标 key（CATEGORY_ICON_KEYS）；null = 按名称映射
  parentId     String?
  sort         Int                 @default(0)
  parent       TransactionCategory?  @relation("TransactionCategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children     TransactionCategory[] @relation("TransactionCategoryTree")
  transactions Transaction[]
  budgets      Budget[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  rev          Int                 @default(1) // 本设备本地修订号，每次写入 +1（F-A）
  vv           String? // 版本向量 JSON {deviceId: maxRev}（F-A）

  @@index([parentId])
  @@map("transaction_categories")
}

model Transaction {
  id                  String      @id @default(uuid())
  importKey           String?     @unique // 导入幂等键：csv:<源ID> 或 natural:<指纹>
  type                String      // 'income' | 'expense' | 'transfer' | 'refund' | 'adjustment'
  amount              BigInt
  fee                 BigInt      @default(0) // 手续费
  coupon              BigInt      @default(0) // 优惠券
  date                DateTime
  note                String?
  accountId            String
  account              Account     @relation("TransactionFrom", fields: [accountId], references: [id])
  toAccountId          String?
  toAccount            Account?    @relation("TransactionTo", fields: [toAccountId], references: [id])
  categoryId           String?
  category             TransactionCategory? @relation(fields: [categoryId], references: [id])
  relatedTransactionId  String?    // 关联的原交易ID（退款时使用）
  relatedType          String?    // 原交易类型：'income' | 'expense'（退款时记录）
  excludeFromIncomeExpense Boolean @default(false) // 不计收支：不参与收入/支出统计（仍影响账户余额）
  relatedTransaction   Transaction? @relation("TransactionRefund", fields: [relatedTransactionId], references: [id], onDelete: SetNull)
  refunds              Transaction[] @relation("TransactionRefund")
  deletedAt            DateTime?   // 软删除时间；null = 未删除（B2，同步墓碑复用此列）
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt @default(now())
  rev                  Int         @default(1) // 本设备本地修订号，每次写入 +1（F-A）
  vv                   String? // 版本向量 JSON {deviceId: maxRev}（F-A）

  @@index([date])
  @@index([accountId, date])
  @@index([categoryId, date])
  @@index([type, date])
  @@index([relatedTransactionId])
  @@index([deletedAt, date])
  @@map("transactions")
}

// 审计事件：删除/修改时写入 before/after 整行快照（JSON），
// 撤销 = 依据事件里的 before 反向写入，不另建撤销表。
model AuditEvent {
  id         String   @id @default(uuid())
  entity     String   // 实体名，如 'transaction' / 'account'
  entityId   String   @map("entity_id")
  action     String   // 'updated' | 'deleted' | 'restored'
  beforeJson String?  @map("before_json")
  afterJson  String?  @map("after_json")
  at         DateTime @default(now())

  @@index([entity, entityId, at])
  @@map("audit_events")
}

model Budget {
  id              String    @id @default(uuid())
  name            String                     // 预算名称，如 "每月工资"、"ETF定投"
  type            String                     // 'income' | 'expense' | 'transfer'
  amount          BigInt
  period          String                     // 'daily' | 'weekly' | 'monthly' | 'quarterly' | 'yearly'
  startDate       DateTime
  endDate         DateTime?                  // null = 无限期
  transactionTime Int?                       // 周期内天偏移，null=周期末
  note            String?                    // 备注
  isActive        Boolean   @default(true)   // 是否活跃

  // 账户关联（与交易对齐）
  accountId   String
  account     Account   @relation("BudgetFrom", fields: [accountId], references: [id])

  toAccountId String?
  toAccount   Account?  @relation("BudgetTo", fields: [toAccountId], references: [id])

  // 分类关联
  categoryId  String
  category    TransactionCategory  @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rev       Int      @default(1) // 本设备本地修订号，每次写入 +1（F-A）
  vv        String? // 版本向量 JSON {deviceId: maxRev}（F-A）

  @@index([type])
  @@index([accountId])
  @@index([categoryId])
  @@index([categoryId, isActive])
  @@map("budgets")
}

model InvestmentAssetClass {
  id          String   @id @default(uuid())
  accountId   String
  name        String
  targetRatio Decimal?
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account         Account                    @relation(fields: [accountId], references: [id])
  allocationItems InvestmentAllocationItem[]

  @@index([accountId])
  @@map("investment_asset_classes")
}

model InvestmentAllocationSnapshot {
  id                  String   @id @default(uuid())
  accountId           String
  date                DateTime
  accountBalance      BigInt
  previousSnapshotId  String?
  note                String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  rev                 Int      @default(1) // 本设备本地修订号，每次写入 +1（F-A）
  vv                  String? // 版本向量 JSON {deviceId: maxRev}（F-A）

  account          Account                     @relation(fields: [accountId], references: [id])
  items            InvestmentAllocationItem[]
  previousSnapshot InvestmentAllocationSnapshot? @relation("SnapshotChain", fields: [previousSnapshotId], references: [id])
  nextSnapshots    InvestmentAllocationSnapshot[] @relation("SnapshotChain")

  @@index([accountId, date])
  @@map("investment_allocation_snapshots")
}

model InvestmentAllocationItem {
  id            String   @id @default(uuid())
  snapshotId    String
  assetClassId  String
  marketValue   BigInt
  periodNetFlow BigInt   @default(0)
  sort          Int      @default(0)

  snapshot   InvestmentAllocationSnapshot @relation(fields: [snapshotId], references: [id])
  assetClass InvestmentAssetClass         @relation(fields: [assetClassId], references: [id])

  @@unique([snapshotId, assetClassId])
  @@map("investment_allocation_items")
}

// 一次导入批次：记录本次实际新建的行 id，回滚只删这些行。
// 不记录被更新的现有行——回滚不负责撤销 merge 导入对旧数据的字段修改。
model ImportBatch {
  id             String    @id @default(uuid())
  createdAt      DateTime  @default(now())
  filename       String
  mode           String    // 'merge' | 'overwrite'
  includesJson   String    // 本次导入的数据类型
  importedJson   String    // 导入结果计数（ImportCounts）
  createdJson    String    // 本次新建行 id：{ transactions: [], accounts: [], ... }
  transactionCount Int     @default(0) // 本次导入新增的流水笔数
  status         String    @default("active") // 'active' | 'rolledBack'
  rolledBackAt   DateTime?
  rolledBackJson String?   // 回滚实际删除的各类行数

  @@index([createdAt])
  @@map("import_batches")
}

// 同步冲突本地表（F-B）：不可比的两个版本都留存。
// **不进容器、不参与同步**——冲突在每台设备上独立检出；输的一版必须落库，
// 否则下一次整份覆盖导出会把它永久丢掉（不变量 8「另一版本必须留存」）。
model SyncConflict {
  id         String    @id @default(uuid())
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  versionA   String    @map("version_a") // 生效（保留）版本，整条记录 JSON
  versionB   String    @map("version_b") // 输的一版，整条记录 JSON
  detectedAt DateTime  @default(now()) @map("detected_at")
  resolvedAt DateTime? @map("resolved_at")

  @@index([entityType, entityId])
  @@index([resolvedAt])
  @@map("sync_conflicts")
}
