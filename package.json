{
  "name": "moneybrain",
  "version": "1.0.0",
  "description": "MoneyBrain 个人记账软件",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev -w @moneybrain/web",
    "dev:api": "npm run dev -w @moneybrain/api",
    "dev:seed": "concurrently \"npm run dev:api\" \"npm run dev:seed -w @moneybrain/web\"",
    "install:all": "npm install",
    "postinstall": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:status": "prisma migrate status --schema apps/api/prisma/schema.prisma",
    "db:drill": "node --import tsx scripts/restore-drill.mts",
    "db:verify": "node --import tsx scripts/db-verify.mts",
    "db:integrity": "node scripts/db-integrity.mjs",
    "sync:decrypt": "node --import tsx scripts/decrypt-container.mts",
    "db:fix-expense-sign": "node --import tsx scripts/fix-expense-sign.mts",
    "spike:v5": "node --import tsx scripts/spike-v5-directory-sync.mts",
    "db:repair-report-data": "node --import tsx scripts/repair-report-data.mts",
    "build": "node scripts/build.mjs",
    "start": "concurrently \"npm run start:api\" \"npm run start:web\"",
    "desktop": "node scripts/desktop.mjs",
    "desktop:open": "node scripts/desktop.mjs",
    "desktop:build": "node scripts/desktop.mjs --build",
    "start:web": "npm run preview -w @moneybrain/web -- --port 4173",
    "start:api": "npm run start:prod -w @moneybrain/api",
    "lint": "npm run lint:api && npm run lint:web",
    "lint:api": "npm run lint -w @moneybrain/api",
    "lint:web": "npm run lint -w @moneybrain/web",
    "typecheck": "npm run typecheck:domain && npm run typecheck:sync && npm run typecheck:api && npm run typecheck:web",
    "typecheck:domain": "npm run typecheck -w @moneybrain/domain",
    "typecheck:sync": "npm run typecheck -w @moneybrain/sync",
    "typecheck:api": "npm run typecheck -w @moneybrain/api",
    "typecheck:web": "npm run typecheck -w @moneybrain/web",
    "test": "npm run test:domain && npm run test:sync && npm run test:api && npm run test:web",
    "test:domain": "npm run test -w @moneybrain/domain",
    "test:sync": "npm run test -w @moneybrain/sync",
    "test:api": "npm run test -w @moneybrain/api",
    "test:web": "npm run test -w @moneybrain/web",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:coverage": "npm run test:coverage -w @moneybrain/api && npm run test:coverage -w @moneybrain/web"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "prisma": "^5.22.0",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "@playwright/test": "^1.50.0"
  }
}
